<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ryotunes_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: High-DPI Status Bitmap + Vector Chip Open Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_header_bmp"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:contentDescription="Status"
            android:scaleType="fitStart" />

        <ImageButton
            android:id="@+id/widget_btn_open"
            android:layout_width="112dp"
            android:layout_height="24dp"
            android:background="@drawable/ryotunes_widget_chip_bg"
            android:contentDescription="Open Ryotunes"
            android:padding="0dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Center Row: Rounded 256px Artwork + Metadata & Live 26x5 FFT Matrix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art_img"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ryotunes_widget_art_bg"
            android:contentDescription="Album artwork"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_meta_bmp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="Track title and artist"
                android:scaleType="fitStart" />

            <ImageView
                android:id="@+id/widget_spectrum_bmp"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:contentDescription="Live FFT visualizer"
                android:scaleType="fitXY" />
        </LinearLayout>
    </LinearLayout>

    <!-- 42-Division Instrument Scale Micro-Bitmap -->
    <ImageView
        android:id="@+id/widget_scale_bmp"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Playback scale"
        android:scaleType="fitXY" />

    <!-- Bottom Row: Elapsed Time Capsule + Vector Transport Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_time_bmp"
                android:layout_width="138dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="Elapsed time"
                android:scaleType="fitStart" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ryotunes_widget_btn_bg"
            android:contentDescription="Previous track"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ryo_prev" />

        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ryotunes_widget_play_bg"
            android:contentDescription="Play or pause"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ryo_play" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:background="@drawable/ryotunes_widget_btn_bg"
            android:contentDescription="Next track"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ryo_next" />
    </LinearLayout>
</LinearLayout>
